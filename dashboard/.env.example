# dashboard/.env.example — kopiera till .env.local och fyll i.
# Vercel-produktion: sätt samma vars som "Environment Variables" på
# project-nivå (Production + Preview).

# ── Supabase EU (eu-north-1 Stockholm) ──────────────────────────────────────
# Tabellen public.customer_profiles bakom RLS deny-all. service_role
# bypassar RLS och får BARA leva server-side (Vercel env, aldrig i klient-
# bundlen). Samma värden som root-projektets .env.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Telegram Watcher-bot ───────────────────────────────────────────────────
# Driver välkomst-notisen efter lyckad onboarding via /api/onboard.
# Samma token som agents/orchestrator/delivery.ts och watcher-boten kör
# (se root .env.example).
TELEGRAM_BOT_TOKEN=

# ── Upstash Redis — rate-limit för /api/onboard ─────────────────────────────
# Begränsar onboardings till 3 per IP per 24h (sliding window) i
# dashboard/lib/ratelimit.ts. Saknas env-varianna ger biblioteket en
# no-op-limiter — fine för lokal dev, men i Vercel-produktion ska BÅDA
# vara satta innan första alfa-kund.
#
# Samma URL/token som root api/verify.ts om operatören vill dela Upstash-
# instans (sparar konfiguration). Annars: skapa ny instans i EU-Frankfurt
# på https://console.upstash.com och kopiera REST URL + REST token.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
